# Auth0 (provisioned via `stripe projects add auth0/client --name auth0-client`)
# Note: Stripe Projects CLI prefixes vars by resource name, so these come out
# as AUTH0_CLIENT_* rather than the SDK's default AUTH0_* names — see src/lib/auth0.ts
AUTH0_CLIENT_DOMAIN=
AUTH0_CLIENT_CLIENT_ID=
AUTH0_CLIENT_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000

# Auth0 Management API (M2M client — must be manually authorized for the
# Auth0 Management API in the Auth0 Dashboard; see setup notes)
DEVDISPATCH_M2M_CLIENT_ID=
DEVDISPATCH_M2M_CLIENT_SECRET=
DEVDISPATCH_M2M_DOMAIN=

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
